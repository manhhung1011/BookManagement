@model BookManagement.Models.Book

<div class="card mt-4">
    <div class="card-body">
        <h3 class="card-title">Chi tiết sách</h3>
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <div class="mb-3">
                <img src="@Model.ImagePath" alt="@Model.Name" style="max-height:240px; width:auto; object-fit:cover;" />
            </div>
        }
        <dl class="row">
            <dt class="col-sm-2">Id</dt>
            <dd class="col-sm-10">@Model.Id</dd>

            <dt class="col-sm-2">Tên</dt>
            <dd class="col-sm-10">@Model.Name</dd>

            <dt class="col-sm-2">Giá</dt>
            <dd class="col-sm-10 book-price">@Model.Price.ToString("N2")</dd>

            <dt class="col-sm-2">Tác giả</dt>
            <dd class="col-sm-10">@(!string.IsNullOrEmpty(Model.Author) ? Model.Author : "Không rõ")</dd>

            <dt class="col-sm-2">Mô tả</dt>
            <dd class="col-sm-10">@Model.Description</dd>
        </dl>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sửa</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Xóa</a>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </div>
</div>
