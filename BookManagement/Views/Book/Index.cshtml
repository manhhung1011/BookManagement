@model List<BookManagement.Models.Book>

<div class="card mt-4">
    <div class="card-body">
        <h2 class="card-title display-6">Danh sách sách</h2>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">@TempData["Message"]</div>
        }
        else if (!string.IsNullOrEmpty(ViewBag.Message))
        {
            <div class="alert alert-success">@ViewBag.Message</div>
        }

        <div class="d-flex justify-content-between align-items-center mb-3">
            <a asp-action="Create" class="btn btn-primary">Thêm sách mới</a>
            <div class="text-muted small">Tổng: @Model?.Count ?? 0</div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Tên sách</th>
                        <th>Giá</th>
                        <th>Tác giả</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model)
                    {
                        <tr>
                            <td>@book.Id</td>
                            <td>@book.Name</td>
                            <td class="book-price">@book.Price.ToString("N2")</td>
                            <td>
                                @if (string.IsNullOrEmpty(book.Author))
                                {
                                    <span class="text-muted">Không rõ</span>
                                }
                                else
                                {
                                    @book.Author
                                }
                            </td>
                            <td class="book-actions">
                                <a asp-action="Detail" asp-route-id="@book.Id" class="btn btn-sm btn-outline-info me-1">Chi tiết</a>
                                <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-warning me-1">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
